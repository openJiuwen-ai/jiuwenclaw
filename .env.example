# Copy to project root .env and adjust as needed
# =============================================================================
# WEB FRONTEND
# =============================================================================
# 前台产品展示名称（web_enterprise / claw_manager web 共用）
# 前台产品展示名称（web_enterprise / claw_manager web 共用）
# 本地开发：仓库根 `.env` → Vite；镜像构建：Dockerfile ARG VITE_PRODUCT_NAME（默认 JiuwenSwarm）
VITE_PRODUCT_NAME=JiuwenSwarm

# =============================================================================
# MANAGER CONFIGURATION
# =============================================================================

# Manager REST API
MANAGER_REST_HOST=0.0.0.0
MANAGER_REST_PORT=8765

# Manager WebSocket Server
MANAGER_WS_ENABLED=true
MANAGER_WS_HOST=0.0.0.0
MANAGER_WS_PORT=8766

# 配置下发字段级加密（信封加密：Manager 加密 / Gateway 解密）
# 密钥无需手配：Gateway 加密公钥在握手时上交 Manager、落库管理，私钥本机自持。
CLAWMANAGER_CONFIG_ENC_ENABLED=false
# 严格模式：含敏感字段但无该实例 Gateway 公钥时拒绝下发（fail-closed）
CLAWMANAGER_CONFIG_ENC_REQUIRED=false
# Gateway 侧解密开关（解密用本机私钥，无需配置密钥）
GATEWAY_CONFIG_DEC_ENABLED=true

# 配置下发加签验签（Ed25519：Manager 加签 / Gateway 验签）
# 密钥无需手配：Manager 签名公钥在握手时下发给 Gateway、落库管理，私钥由 Manager 自持。
CLAWMANAGER_CONFIG_SIGN_ENABLED=false
CLAWMANAGER_CONFIG_SIGN_ALG=Ed25519
# Gateway 侧验签开关、强制态与时间窗
GATEWAY_CONFIG_VERIFY_ENABLED=true
GATEWAY_CONFIG_VERIFY_REQUIRED=false
GATEWAY_CONFIG_SIGN_SKEW_SECONDS=300

# 控制链路握手双向鉴权（非对称 Ed25519 + TOFU 指纹固定：manager↔gateway、gateway↔agentserver）
# 开关：off(默认，行为与引入前完全一致) / observe(验签+记日志但不拒绝，灰度用) / enforce(验不过即拒)
# 各端身份密钥自动生成、私钥不出端，无需手配密钥。
CLAW_LINK_AUTH_MODE=off
# 令牌有效期（秒），默认 300；令牌每次连接现签（含 nonce 防重放 + 签发时间）
CLAW_LINK_TOKEN_TTL=300

# Gateway WS heartbeat: mark instance offline if no heartbeat within timeout (seconds)
MANAGER_HEARTBEAT_TIMEOUT_SECONDS=120
# How often Manager scans for stale heartbeats (seconds)
MANAGER_HEARTBEAT_SCAN_INTERVAL_SECONDS=60

# Manager database: sqlite | mysql
MANAGER_DB_TYPE=sqlite
MANAGER_SQLITE_PATH=manager.db
MANAGER_DB_HOST=127.0.0.1
MANAGER_DB_PORT=3306
MANAGER_DB_USER=root
MANAGER_DB_PASSWORD=root
MANAGER_DB_NAME=manager

# 允许 Manager 本地一键拉起（仅本地开发：Manager 后端 API 校验 + claw_manager 前台 Vite 读取）
MANAGER_ALLOW_LOCAL_PROVISION=true

# =============================================================================
# GATEWAY CONFIGURATION
# =============================================================================
# Gateway database: sqlite | mysql
GATEWAY_DB_TYPE=sqlite
GATEWAY_SQLITE_PATH=gateway.db
GATEWAY_DB_HOST=127.0.0.1
GATEWAY_DB_PORT=3306
GATEWAY_DB_USER=root
GATEWAY_DB_PASSWORD=root
GATEWAY_DB_NAME=gateway

# --- Manager WebSocket Client on Gateway (manager_ws_client) ---
GATEWAY_MANAGER_WS_CLIENT_ENABLED=true
GATEWAY_MANAGER_WS_URL=ws://127.0.0.1:8766
# Fast-phase reconnect attempts before switching to probe mode (0 = exponential backoff only)
GATEWAY_MANAGER_WS_MAX_RECONNECT_ATTEMPTS=3
# Delay between fast-phase Manager WS reconnect attempts (seconds)
GATEWAY_MANAGER_WS_RECONNECT_INTERVAL_SECONDS=3
# Probe-mode interval when Manager is unavailable (seconds)
GATEWAY_MANAGER_WS_PROBE_INTERVAL_SECONDS=120
# Interval for Gateway → Manager WebSocket heartbeats (seconds)
GATEWAY_MANAGER_WS_HEARTBEAT_INTERVAL_SECONDS=60

# Gateway 日志脱敏开关（true/false，默认 true；读仓库根 .env 或容器注入的环境变量）
LOG_MASK_ENABLED=true
