# Jiuwenclaw 用户数据根目录（须为可直接使用的绝对路径；展开后作为 jiuwenclaw.utils.USER_WORKSPACE_DIR）。
# 未设置时 Python 侧默认为 ~/.jiuwenclaw（见 jiuwenclaw/utils.py 模块级 USER_WORKSPACE_DIR）。
# 宿主集成（如 OfficeClaw relay sidecar）可设为 …/<office-claw-data>/.jiuwenclaw，与 config/agent/.logs 等布局一致。
JIUWENCLAW_DATA_DIR=

# 大模型 API 基础地址（必填，示例：https://open.bigmodel.cn/api/paas/v4）
# ⚠ 请勿使用 example.com 等占位域名，否则会收到 HTML 页面而非 API 响应
API_BASE=
API_KEY="sk-xxxxxxxxx"
MODEL_NAME="your-model-name"
# or other provider like SiliconFlow, etc.
MODEL_PROVIDER=OpenAI
DEFAULT_HEADERS=

EMBED_API_BASE=
EMBED_API_KEY=
EMBED_MODEL=

# Video processing model configuration.
VIDEO_API_BASE=
VIDEO_API_KEY=
VIDEO_MODEL_NAME="your-video-model-name"
VIDEO_PROVIDER=OpenAI

# Audio processing model selection.
AUDIO_API_BASE=
AUDIO_API_KEY=
AUDIO_MODEL_NAME="your-audio-model-name"
AUDIO_PROVIDER=OpenAI

# Vision/Image processing model selection.
VISION_API_BASE=
VISION_API_KEY=
VISION_MODEL_NAME="your-vision-model-name"
VISION_PROVIDER=OpenAI

# Image generation model (text-to-image).
IMAGE_GEN_API_BASE=
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL_NAME="your-image-gen-model-name"
IMAGE_GEN_PROVIDER=DashScope

JINA_API_KEY=
BOCHA_API_KEY=
SERPER_API_KEY=
PERPLEXITY_API_KEY=
GITHUB_TOKEN=
FREE_SEARCH_PROXY_URL=
# Disable SSL certificate verification for jiuwenclaw HTTP tools.
# Useful behind corporate TLS interception proxies or self-signed certificates.
# Default: true
# JIUWENCLAW_SSL_VERIFY=false

# 搜索引擎开关
# DuckDuckGo 直接搜索 - 设置为 1 启用
JIUWENCLAW_ENABLE_DDG_SEARCH=0
# DuckDuckGo via Jina 代理搜索 - 设置为 1 启用
JIUWENCLAW_ENABLE_JINA_SEARCH=0
# Jina Reader 网页抓取（mcp_fetch_webpage 并行 fallback）- 设置为 1 启用；国内默认保持 0
JIUWENCLAW_ENABLE_JINA_FETCH=0

# Browser MCP runtime (optional)
# 0: disabled, 1: enabled
BROWSER_RUNTIME_MCP_ENABLED=1
# supported here: stdio|sse|streamable-http
# recommended: streamable-http
BROWSER_RUNTIME_MCP_CLIENT_TYPE=streamable-http
BROWSER_RUNTIME_MCP_SERVER_ID=playwright_runtime_wrapper
BROWSER_RUNTIME_MCP_SERVER_NAME=playwright-runtime-wrapper
# when client_type=streamable-http, default endpoint is http://127.0.0.1:8940/mcp
# when client_type=sse, default endpoint is http://127.0.0.1:8940/sse
# when client_type=stdio, this path can keep stdio://... as metadata only
BROWSER_RUNTIME_MCP_SERVER_PATH=http://127.0.0.1:8940/mcp
BROWSER_RUNTIME_MCP_TIMEOUT_S=300
# optional local wrapper host/port/path for auto-start
BROWSER_RUNTIME_MCP_HOST=127.0.0.1
BROWSER_RUNTIME_MCP_PORT=8940
BROWSER_RUNTIME_MCP_PATH=/mcp
# stdio mode command override (empty means use current python executable)
BROWSER_RUNTIME_MCP_COMMAND=
# optional args override; leave empty to use built-in default:
# <repo>/jiuwenclaw/agentserver/tools/browser-move/src/playwright_runtime_mcp_server.py --transport stdio --no-banner
BROWSER_RUNTIME_MCP_ARGS=
# stdio mode will prefer sse fallback first when enabled (recommended 1)
BROWSER_RUNTIME_MCP_AUTO_SSE_FALLBACK=1

# runtime wrapper internals
PLAYWRIGHT_MCP_COMMAND=npx
PLAYWRIGHT_MCP_ARGS=-y @playwright/mcp@latest
PLAYWRIGHT_CDP_URL=http://127.0.0.1:9222
PLAYWRIGHT_TOOL_TIMEOUT_S=300
BROWSER_TIMEOUT_S=300
# default behavior: browser_run_task will not honor model-provided timeout_s values below
# BROWSER_TIMEOUT_S. Set this only if you explicitly want short per-call overrides.
BROWSER_ALLOW_SHORT_TIMEOUT_OVERRIDE=0

######## BROWSER MOVE MODE ########
# managed browser
BROWSER_DRIVER=managed
BROWSER_PROFILE_NAME=Default

# # remote browser 
# BROWSER_DRIVER=remote
# PLAYWRIGHT_CDP_URL=http://127.0.0.1:9222

# # playwright extension browser 
# BROWSER_DRIVER=extension
# PLAYWRIGHT_MCP_EXTENSION_TOKEN=

EMAIL_ADDRESS=""
EMAIL_TOKEN=""

EVOLUTION_AUTO_SCAN="false"

# SkillNet timeout configuration
SKILLNET_DOWNLOAD_TIMEOUT=60
SKILLNET_MAX_RETRIES=3

NO_PROXY=localhost,127.0.0.1,api.openai.rnd.huawei.com

# Memory mode (default is "local" when empty)
MEMORY_MODE=

# Extension package search dirs, separated by ';'
EXTENSION_DIRS=""

# === 日志系统环境变量覆盖（日志系统迁移 - JSON格式化 + user_visible标记） ===
# 全局输出格式控制
JIUWENCLAW_LOG_FORMAT=text  # text/json/dual（覆盖 config.yaml logging.format）

# 输出开关控制
JIUWENCLAW_LOG_CONSOLE_ENABLED=true  # true/false（覆盖 config.yaml logging.console_enabled）
JIUWENCLAW_LOG_FILE_ENABLED=true     # true/false（覆盖 config.yaml logging.file_enabled）

# Tag显示控制
JIUWENCLAW_LOG_USER_VISIBLE=true           # true/false（覆盖 config.yaml logging.tags.user_visible）
JIUWENCLAW_LOG_USER_PROGRESS_VISIBLE=true   # true/false（覆盖 config.yaml logging.tags.user_progress_visible）

# Agent client REST extension (docker/extensions/agent_client): listen bind and toggle
# Leave empty to use defaults from config.yaml (${AGENT_CLIENT_REST_*:-...})
# AGENT_CLIENT_REST_ENABLED=true
# AGENT_CLIENT_REST_HOST=127.0.0.1
# AGENT_CLIENT_REST_PORT=18080

# === 对象存储配置（AgentServer 内部使用） ===
# 存储后端类型：local, huawei-obs, aliyun-oss
STORAGE_TYPE=local

# 本地存储配置
# STORAGE_LOCAL_BASE_DIR=~/.jiuwenclaw/storage/local
# STORAGE_LOCAL_UPLOAD_DIR=~/.jiuwenclaw/uploads

# 华为云 OBS 配置
# OBS_ACCESS_KEY=your-access-key-id
# OBS_SECRET_KEY=your-secret-access-key
# OBS_ENDPOINT=obs.cn-north-4.myhuaweicloud.com
# OBS_BUCKET=your-bucket-name

# 阿里云 OSS 配置
# OSS_ACCESS_KEY=your-access-key-id
# OSS_SECRET_KEY=your-secret-access-key
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET=your-bucket-name

# Uncomment only when you need to disable JiuwenClaw cron/scheduled-task tools.
# JIUWENCLAW_DISABLE_CRON_TOOLS=1
