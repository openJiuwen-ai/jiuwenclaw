# ====================== claw-gateway服务配置 ======================
# 运行环境模式：支持 dev / product 两种值
# dev 模式：将宿主机代码目录挂载到容器内，支持代码实时修改调试
# product 模式：使用容器内置代码，不挂载宿主机目录，用于生产环境
MODE=product

# 仅在 MODE=dev 时生效：宿主机本地代码路径（请填写绝对路径）
HOST_CODE_PATH=""

# 产品模式（MODE=product）下的claw-gateway镜像地址
GATEWAY_PRODUCT_IMAGE=""

# 开发模式（MODE=dev）下的claw-gateway镜像地址
GATEWAY_DEV_IMAGE=""

# jiuwen_runtime编排管理（AGENT_RUNTIME=jiuwen）下的claw-gateway镜像地址
GATEWAY_RT_IMAGE=""

# Gatway实例内存限制（单位：Gi）
GATEWAY_MEMORY=1

# 网关同时向后端发送的最大并发请求数
GATEWAY_CONCURRENCY=1

# 网关调用后端接口的超时时间
GATEWAY_INVOKE_TIMEOUT=60

# SessionMap 会话映射策略
# 仅适用于企业版 Claw 场景（如 feishu_enterprise 等企业通道）
# 作用：将平台用户身份映射为 Agent 内部会话唯一标识（session_id）
# 可选值：
#   per_chat_bot        - 默认值，同一聊天窗口+机器人共享会话
#   per_chat_bot_user   - 按用户维度隔离会话（每个用户独立会话）
GATEWAY_SESSION_MAP_SCOPE="per_chat_bot_user"


# AgentServer 客户端通信模式配置， 支持如下可选客户端类型：
#   jiuwen      - jiuwen_runtime编排管理客户端，由 AgentServerClientExtension 组件提供
AGENT_RUNTIME="jiuwen"

# ====================== Runtime Deployer(AGENT_RUNTIME=jiuwen) 配置 ======================

# AgentServer镜像地址
AGENT_SERVER_IMAGE=""

# PIP 安装扩展依赖时的额外参数
# 示例配置阿里云PyPI镜像源，优化内网/国内环境包下载速度，可根据实际环境自定义调整
PIP_EXTRA_ARGS="-i https://mirrors.aliyun.com/pypi/simple"

# ====================== 大模型接口配置 ======================
# 模型厂商标识（如：OpenAI等）
MODEL_PROVIDER=""

# 大模型名称
MODEL_NAME=""

# 大模型API基础地址
API_BASE=""

# 大模型鉴权密钥
API_KEY=""

# ====================== 向量模型接口配置 ======================
# 向量模型名称
EMBED_MODEL=""

# 向量模型API基础地址
EMBED_API_BASE=""

# 向量模型鉴权密钥
EMBED_API_KEY=""


# ==============================================================
# 飞书机器人配置（FEISHU_BOTS）
# 配置格式：一行一个机器人，规则为 Bot Name:App ID:App Secret
# 示例：
# FEISHU_BOTS="
# bot_name_1:app_id_1:app_secret_1
# bot_name_2:app_id_2:app_secret_2
# bot_name_3:app_id_3:app_secret_2
#"

FEISHU_BOTS="
"

# ====================== NFS服务配置======================
# NFS 服务器外部连接地址, 留空则使用部署脚本自动创建的内置 NFS sver
NFS_SERVER_ADDR=""

# NFS 共享路径
NFS_SHARE_PATH="/"

# ====================== WEB服务配置 ======================
# Web 前端模块容器镜像地址
WEB_IMAGE=""

# Web 服务对外暴露的主机端口（可被部署脚本 --web-port 参数覆盖）
WEB_HOST_PORT=8080


# ====================== RabbitMQ服务配置 ======================
# RabbitMQ 外部连接地址（格式：host:port）, 留空则使用部署脚本自动创建的内置 RabbitMQ
RABBITMQ_URL=""

# RabbitMQ 登录用户名（用于AMQP认证，与服务端配置保持一致）
RABBITMQ_USER=""

# RabbitMQ 登录密码（支持特殊字符，会自动进行URL编码处理）
RABBITMQ_PASSWORD=""


# ====================== MySQL服务配置 ======================
# MYSQL 外部连接地址, 留空则使用部署脚本自动创建的内置 MySQL地址
MYSQL_HOST=""

# MYSQL 外部连接端口, 留空则使用部署脚本自动创建的内置 MySQL端口
MYSQL_PORT=""

# MySQL root的密码（内置 MySQL 部署时设置密码，外部 MySQL 填写对应密码）
MYSQL_ROOT_PASSWORD=""

# ====================== PostgreSQL服务配置 ======================
# PostgreSQL 外部连接地址, 留空则使用部署脚本自动创建的内置 PostgreSQL
POSTGRES_HOST=""

# PostgreSQL 外部连接端口
POSTGRES_PORT=""

# PostgreSQL 密码（内置部署时设置密码，外部 PostgreSQL 填写对应密码）
POSTGRES_PASSWORD=""


# ====================== CLAW-MANAGER服务配置 ======================
# 产品模式（MODE=product）下的CLAW-MANAGER镜像地址
MANAGER_PRODUCT_IMAGE=""

# 开发模式（MODE=dev）下的CLAW-MANAGER镜像地址
MANAGER_DEV_IMAGE=""

# Web 服务对外暴露的访问端口
MANAGER_NODE_PORT="30086"

# ====================== 其他IMAGE ======================
# NFS模块的镜像地址
# 默认值itsthenetwork/nfs-server-alpine:12， 如果拉不下来，可以试试如下值
NFS_IMAGE=docker.1ms.run/itsthenetwork/nfs-server-alpine:12
