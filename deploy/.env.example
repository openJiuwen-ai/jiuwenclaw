# 运行环境模式：支持 dev / product 两种值
# 可以用于调试 gateway、manager 业务模块
# dev 模式：将宿主机代码目录挂载到容器内，支持代码实时修改调试
# product 模式：使用容器内置代码，不挂载宿主机目录，用于生产环境
MODE=product

# 仅在 MODE=dev 时生效：宿主机本地代码路径（请填写绝对路径）
HOST_CODE_PATH=""

# 数据库类型，支持mysql、sqlite、postgresql, 不配默认就是sqlite
DB_TYPE="sqlite"


# ====================== NFS服务配置======================
# NFS模块的镜像地址
# 默认值itsthenetwork/nfs-server-alpine:12， 如果拉不下来，可以试试如下值
NFS_IMAGE=docker.1ms.run/itsthenetwork/nfs-server-alpine:12

# 外挂 NFS 服务的连接地址, 不设置则使用部署脚本创建的自建 NFS sver
NFS_SERVER_ADDR=""

# AppServer在NFS中的共享目录
# 集群内自建 NFS 不用填; 外挂 NFS 服务请确保该目录存在，并且目录属主UID/GID统一为1000
JIUWENCLAW_NFS_PATH=""

# 集群内自建 RabbitMQ 在NFS中的共享目录
# 集群内自建 NFS 不用填; 外挂 NFS 服务请确保该目录存在，并且目录属主UID/GID统一为1000
# 外挂 RabbitMQ 不用填
RABBITMQ_NFS_PATH=""

# 集群内自建 MySQL 在NFS中的共享目录
# 集群内自建 NFS 不用填; 外挂 NFS 服务请确保该目录存在，并且目录属主UID/GID统一为1000
# 外挂 MySQL 不用填
MYSQL_NFS_PATH=""

# 集群内自建 PostgreSQL 在NFS中的共享目录
# 集群内自建 NFS 不用填; 外挂 NFS 服务请确保该目录存在，并且目录属主UID/GID统一为1000
# 外挂 PostgreSQL 不用填
POSTGRES_NFS_PATH=""


# ====================== MySQL 服务配置（DB_TYPE="mysql"） ======================
# 外挂 MySQL 服务的连接地址, 不设置则使用部署脚本创建的自建 MySQL 服务的地址
MYSQL_HOST=""

# 外挂 MySQL 的连接端口, 不设置则使用部署脚本创建的自建 MySQL 服务的端口
MYSQL_PORT=""

# MySQL root的密码（集群内自建 MySQL 部署时设置密码，外部 MySQL 填写对应密码）
MYSQL_ROOT_PASSWORD=""

# 自建 MySQL 存储容量（默认4Gi），外挂 MySQL 服务不用填
MYSQL_STORAGE_SIZE="4Gi"

# 集群内自建 MySQL 服务（部署工具创建）对外暴露的访问端口
# 不设置就自动寻找空闲端口，如需要设置，请确保该端口的唯一性（范围: 30000-32767）
MYSQL_NODE_PORT=


# ====================== PostgreSQL服务配置 （DB_TYPE="postgresql"）======================
# 外挂 PostgreSQL 服务的连接地址, 不设置则使用部署脚本创建的自建PostgreSQL
POSTGRES_HOST=""

# 外挂 PostgreSQL 的连接端口
POSTGRES_PORT=

# PostgreSQL 密码（集群内自建部署时设置密码，外部 PostgreSQL 填写对应密码）
POSTGRES_PASSWORD=""

# 自建 PostgreSQL 存储容量（默认4Gi），外挂 PostgreSQL 服务不用填
POSTGRES_STORAGE_SIZE="4Gi"

# 集群内自建 PostgreSQL 服务（部署工具创建）对外暴露的访问端口
# 不设置就自动寻找空闲端口，如需要设置，请确保该端口的唯一性（范围: 30000-32767）
POSTGRES_NODE_PORT=

# ====================== RabbitMQ服务配置 ======================
# 外挂 RabbitMQ 服务的连接地址（格式：host:port）, 不设置则使用部署脚本创建的自建 RabbitMQ
RABBITMQ_URL=""

# RabbitMQ 登录用户名（集群内自建 RabbitMQ 部署时设置密码，外部 RabbitMQ 填写对应密码）
RABBITMQ_USER=""

# RabbitMQ 登录密码（集群内自建 RabbitMQ 部署时设置密码，外部 RabbitMQ 填写对应密码）
RABBITMQ_PASSWORD=""

# 自建 RabbitMQ 存储容量（默认2Gi），外挂 RabbitMQ 服务不用填
RABBITMQ_STORAGE_SIZE="2Gi"

# 集群内自建 的 RabbitMQ 服务（部署工具创建）对外暴露的访问端口
# 不设置就自动寻找空闲端口，如需要设置，请确保该端口的唯一性（范围: 30000-32767）
RABBITMQ_AMQ_NODE_PORT=
RABBITMQ_MGR_NODE_PORT=


# ====================== Redis 服务配置 ======================
# DEPLOYMENT_MODE=active-standby 时，Gateway 需要连接 Redis
# 外挂 Redis 服务的连接地址, 不设置则使用部署脚本创建的自建 Redis
REDIS_HOST=""

# 外挂 Redis 的连接端口
REDIS_PORT=

# 外挂 Redis 密码
REDIS_PASSWORD=""

# 集群内自建 Redis 服务（部署工具创建）对外暴露的访问端口
# 不设置就自动寻找空闲端口，如需要设置，请确保该端口的唯一性（范围: 30000-32767）
REDIS_NODE_PORT=

# ====================== Gateway 服务配置 ======================
# Gateway 服务镜像地址
GATEWAY_IMAGE=""

# Gateway 服务对外暴露的访问端口
# 不设置就自动寻找空闲端口，如需要设置，请确保该端口的唯一性（范围: 30000-32767）
GATEWAY_NODE_PORT=

# 网关同时向后端发送的最大并发请求数
GATEWAY_CONCURRENCY=1

# 网关调用后端接口的超时时间
GATEWAY_INVOKE_TIMEOUT=60

# SessionMap 会话映射策略
# 仅适用于企业版 Claw 场景（如 feishu_enterprise 等企业通道）
# 作用：将平台用户身份映射为 Agent 内部会话唯一标识（session_id）
# 可选值：
#   per_chat_bot        - 默认值，同一聊天窗口+机器人共享会话
#   per_chat_bot_user   - 按用户维度隔离会话（每个用户独立会话）
GATEWAY_SESSION_MAP_SCOPE="per_chat_bot_user"

# Gateway 部署模式：standalone（默认，不连 Redis）| active-standby（多实例主备，需 Redis）
DEPLOYMENT_MODE=standalone

# active-standby 建议显式设置 GATEWAY_INSTANCE_ID，避免 Pod 重启后 Cron/Session 键变化
GATEWAY_INSTANCE_ID=

# Gateway 服务的容器最小保证 CPU：0.5核（500毫核），K8s 必须分配足够CPU才能调度启动
GATEWAY_CPU_REQUEST=500m

# Gateway 服务的容器最小保证 内存：1Gi，K8s 必须分配足够内存才能调度启动
GATEWAY_MEMORY_REQUEST=1Gi

# Gateway 服务的容器最大可用 CPU：0.5核，超出会被K8s限流
GATEWAY_CPU_LIMIT=500m

# Gateway 服务的容器最大可用 内存：1Gi，超出会被K8s强制杀死重启
GATEWAY_MEMORY_LIMIT=1Gi

# AgentServer 客户端通信模式配置， 支持如下可选客户端类型：
#   jiuwen      - jiuwen_runtime编排管理客户端，由 AgentServerClientExtension 组件提供
AGENT_RUNTIME="jiuwen"


# ====================== AgentServer 配置 ======================
# AgentServer 服务镜像地址
AGENT_SERVER_IMAGE=""

#拓展配置自定义rail
AGENT_EXTRA_RAILS=""

# PIP 安装扩展依赖时的额外参数
# 示例配置阿里云PyPI镜像源，优化内网/国内环境包下载速度，可根据实际环境自定义调整
PIP_EXTRA_ARGS="-i https://mirrors.aliyun.com/pypi/simple"

# AgentServer 服务的容器最小保证 CPU：500毫核（0.5核），K8s 必须至少分配这么多 CPU 才能启动
AGENT_SERVER_CPU_REQUEST=500m

# AgentServer 服务的容器最小保证 内存：1Gi，K8s 必须至少分配这么多内存才能启动
AGENT_SERVER_MEMORY_REQUEST=1Gi

# AgentServer 服务的容器最大可用 CPU：500毫核（0.5核），超过会被 K8s 限流
AGENT_SERVER_CPU_LIMIT=500m

# AgentServer 服务的容器最大可用 内存：1Gi，超过会被 K8s OOM kill 杀死重启
AGENT_SERVER_MEMORY_LIMIT=1Gi

# ======================  JIUWENBOX 配置 ======================
# JIUWENBOX 服务镜像地址
JIUWENBOX_IMAGE="swr.cn-north-4.myhuaweicloud.com/openjiuwen/jiuwenclaw-sandbox-amd64:0.0.46k"

#是否开启 JIUWENBOX
JIUWENBOX_ENABLED=true

# JIUWENBOX 服务的容器最小保证 CPU：500毫核（0.5核），K8s 必须至少分配这么多 CPU 才能启动
JIUWENBOX_CPU_REQUEST=500m

# JIUWENBOX 服务的容器最小保证 内存：1Gi，K8s 必须至少分配这么多内存才能启动
JIUWENBOX_MEMORY_REQUEST=1Gi

# JIUWENBOX 服务的容器最大可用 CPU：500毫核（0.5核），超过会被 K8s 限流
JIUWENBOX_CPU_LIMIT=500m

# JIUWENBOX 服务的容器最大可用 内存：1Gi，超过会被 K8s OOM kill 杀死重启
JIUWENBOX_MEMORY_LIMIT=1Gi


# ====================== 大模型接口配置 ======================
# 模型厂商标识（如：OpenAI等）
MODEL_PROVIDER=""

# 大模型名称
MODEL_NAME=""

# 大模型API基础地址
API_BASE=""

# 大模型鉴权密钥
API_KEY=""


# ====================== 向量模型接口配置 ======================
# 向量模型名称
EMBED_MODEL=""

# 向量模型API基础地址
EMBED_API_BASE=""

# 向量模型鉴权密钥
EMBED_API_KEY=""


# ==============================================================
# 飞书机器人配置（FEISHU_BOTS）
# 配置格式：一行一个机器人，规则为 Bot Name:App ID:App Secret
# 示例：
# FEISHU_BOTS="
# bot_name_1:app_id_1:app_secret_1
# bot_name_2:app_id_2:app_secret_2
# bot_name_3:app_id_3:app_secret_2
#"
FEISHU_BOTS="
"


# ====================== WEB服务配置 ======================
# Web 前端模块容器镜像地址
WEB_IMAGE=""

# Web 服务对外暴露的主机端口（可被部署脚本 --web-port 参数覆盖）
# 不设置就自动寻找空闲端口，如需要设置，请确保该端口的唯一性（范围: 30000-32767）
WEB_NODE_PORT=


# ====================== MANAGER服务配置 ======================
# MANAGER镜像地址
MANAGER_IMAGE=""

# MANAGER 服务对外暴露的访问端口
# 不设置就自动寻找空闲端口，如需要设置，请确保该端口的唯一性（范围: 30000-32767）
MANAGER_NODE_PORT=
