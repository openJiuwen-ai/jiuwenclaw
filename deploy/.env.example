# ====================== claw-manager服务配置 ======================
# claw-manager镜像地址
CLAW_MGR_IMAGE=""

# 单实例CPU限制（单位：毫核，300=0.3核）
CLAW_MGR_CPU=300

# 单实例内存限制（单位：Mi）
CLAW_MGR_MEMORY=600

# 服务最小实例数
CLAW_MGR_MIN_INSTANCE=1

# 服务最大实例数
CLAW_MGR_MAX_INSTANCE=10

# 服务并发处理数量/最大并发数
CLAW_MGR_CONCURRENT_NUM=10


# ====================== claw-gateway服务配置 ======================
# claw-gateway镜像地址
CLAW_GATEWAY_IMAGE=""

# ====================== 大模型接口配置 ======================

# 模型厂商标识（如：OpenAI等）
MODEL_PROVIDER=""

# 大模型名称
MODEL_NAME=""

# 大模型API基础地址
API_BASE=""

# 大模型鉴权密钥
API_KEY=""

# ====================== 向量模型接口配置 ======================
# 向量模型名称
EMBED_MODEL=""

# 向量模型API基础地址
EMBED_API_BASE=""

# 向量模型鉴权密钥
EMBED_API_KEY=""

# ==============================================================
# 飞书机器人配置（FEISHU_BOTS）
# 配置格式：一行一个机器人，规则为 机器人名称:App ID:App Secret
# 示例：
# FEISHU_BOTS="
# 智能助手:cli_xxxxxx:sec_xxxxxx
# 告警机器人:cli_yyyyyy:sec_yyyyyy
# "
# ==============================================================
FEISHU_BOTS="
"

# 运行环境模式：支持 dev / product 两种值
# dev 模式：将宿主机代码目录挂载到容器内，支持代码实时修改调试
# product 模式：使用容器内置代码，不挂载宿主机目录，用于生产环境
MODE=product

# 仅在 MODE=dev 时生效：宿主机本地代码路径（请填写绝对路径）
HOST_CODE_PATH=""