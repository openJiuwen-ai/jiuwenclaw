{
  "_copyright": "Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.",
  "id": "filesystem/ls",
  "family": "filesystem-listing",
  "description": "Compact ls output for directory listings.",
  "match": {
    "toolNames": [
      "exec"
    ],
    "argv0": [
      "ls"
    ]
  },
  "transforms": {
    "stripAnsi": true,
    "dedupeAdjacent": true,
    "trimEmptyEdges": true
  },
  "summarize": {
    "head": 20,
    "tail": 20
  },
  "failure": {
    "preserveOnFailure": true,
    "head": 20,
    "tail": 20
  },
  "counters": [
    {
      "name": "item",
      "pattern": "^(?!total\\s+\\d+).+\\S.*$"
    }
  ]
}
