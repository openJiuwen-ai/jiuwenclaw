{
  "_copyright": "Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.",
  "id": "generic/fallback",
  "family": "generic",
  "description": "Generic fallback reducer for line-oriented output.",
  "match": {},
  "transforms": {
    "stripAnsi": true,
    "dedupeAdjacent": true,
    "trimEmptyEdges": true
  },
  "counters": [
    {
      "name": "error",
      "pattern": "error",
      "flags": "i"
    },
    {
      "name": "warning",
      "pattern": "warning",
      "flags": "i"
    }
  ]
}
