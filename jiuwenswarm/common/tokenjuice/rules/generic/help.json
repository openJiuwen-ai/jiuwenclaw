{
  "_copyright": "Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.",
  "id": "generic/help",
  "family": "help",
  "description": "Preserve command help output so agents can inspect available commands and flags.",
  "priority": 25,
  "match": {
    "toolNames": [
      "exec"
    ],
    "argvIncludesAny": [
      [
        "--help"
      ],
      [
        "help"
      ]
    ],
    "commandIncludesAny": [
      " --help",
      " help"
    ]
  },
  "transforms": {
    "stripAnsi": true,
    "dedupeAdjacent": true,
    "trimEmptyEdges": true
  },
  "summarize": {
    "head": 40,
    "tail": 20
  },
  "failure": {
    "preserveOnFailure": true,
    "head": 40,
    "tail": 20
  }
}
