[
  {
    "id": "SR-001",
    "name": "动态代码执行",
    "severity": "suspicious",
    "description": "使用 eval()、Function() 或 vm 模块动态执行代码",
    "rules": [
      "(?:eval\\s*\\(|new\\s+Function\\s*\\(|vm\\.runIn(?:ThisContext|NewContext)|vm\\.Script)"
    ],
    "require_both": false,
    "examples": [
      "eval(userInput)",
      "new Function('return ' + data)"
    ]
  },
  {
    "id": "SR-002",
    "name": "代码严重混淆",
    "severity": "suspicious",
    "description": "代码使用高 entropy 变量名、大量字符串拼接或 base64 编码，可能隐藏恶意行为",
    "rules": [
      "(?:var\\s+_0x[a-f0-9]{4,}|String\\.fromCharCode\\s*\\([0-9,]{50,}|\\\\x[0-9a-f]{2}\\\\x[0-9a-f]{2,}|unescape\\s*\\()"
    ],
    "require_both": false,
    "examples": [
      "var _0x1a2b=_0x3c4d;",
      "String.fromCharCode(104,101,108,108,111)"
    ]
  },
  {
    "id": "SR-004",
    "name": "大范围文件写入",
    "severity": "suspicious",
    "description": "插件在自身目录之外写入大量文件，可能存在篡改风险",
    "rules": [
      "fs\\.(?:writeFile|writeFileSync|appendFile|appendFileSync|copyFile|copyFileSync|rename|renameSync)\\s*\\([\"\\u005E'](?!\\.)"
    ],
    "require_both": false,
    "examples": [
      "fs.writeFileSync('/usr/local/bin/malware', ...)"
    ]
  },
  {
    "id": "SR-005",
    "name": "Shell 命令执行",
    "severity": "suspicious",
    "description": "插件通过 child_process 或 shell 执行系统命令",
    "rules": [
      "(?:child_process\\.|require\\([\\s\\'\\\"]child_process[\\s\\'\\\"]\\)|exec\\s*\\(|execSync|execFile|execFileSync|spawn\\s*\\(|spawnSync|shelljs)"
    ],
    "require_both": false,
    "examples": [
      "child_process.exec('ls -la')",
      "require('child_process').execSync('curl ...')"
    ]
  },
  {
    "id": "SR-006",
    "name": "网络请求+路径拼接",
    "severity": "suspicious",
    "description": "插件动态拼接文件路径并从网络下载内容，可能存在供应链投毒",
    "rules": [
      "(?:fetch|axios|http\\.get|https\\.get|got|request)",
      "(?:path\\.join|path\\.resolve|writeFile|appendFile|createWriteStream)"
    ],
    "require_both": true,
    "examples": [
      "fetch(url).then(r => fs.writeFileSync(path.join(__dirname, r.data)))"
    ]
  },
  {
    "id": "SR-007",
    "name": "动态 require",
    "severity": "suspicious",
    "description": "使用变量拼接的 require 路径，可能动态加载恶意模块",
    "rules": [
      "require\\s*\\([^\"'\\u005E\\)]+(?:\\+|concat)"
    ],
    "require_both": false,
    "examples": [
      "require('./plugins/' + pluginName)"
    ]
  },
  {
    "id": "SR-008",
    "name": "删除文件",
    "severity": "suspicious",
    "description": "插件尝试删除文件或目录，可能是清理痕迹",
    "rules": [
      "fs\\.(?:unlink|unlinkSync|rm|rmSync|rmdir|rmdirSync)\\s*\\("
    ],
    "require_both": false,
    "examples": [
      "fs.unlinkSync('/var/log/evidence.log')"
    ]
  }
]
