# 复制为 .env 后按需修改（Claw Manager 启动时自动加载）

# REST 服务
MANAGER_REST_HOST=0.0.0.0
MANAGER_REST_PORT=8765

# manager_ws_server（Gateway manager_ws_client 长连接）
MANAGER_WS_ENABLED=true
MANAGER_WS_HOST=0.0.0.0
MANAGER_WS_PORT=8766

# 数据库：sqlite | mysql | postgresql
MANAGER_DB_TYPE=sqlite
MANAGER_SQLITE_PATH=manager.db

# MySQL（CLAW_MANAGER_DB_TYPE=mysql或postgresql 时生效）
# MySQL（MANAGER_DB_TYPE=mysql或postgresql 时生效）
MANAGER_DB_HOST=127.0.0.1
MANAGER_DB_PORT=3306
MANAGER_DB_USER=root
MANAGER_DB_PASSWORD=root
MANAGER_DB_NAME=manager

# 可选：RabbitMQ / 上游 / 本地 provision（保留 CLAWMANAGER_ 前缀）
# AMQP 默认端口 5672；15672 是 Management 管理界面 HTTP 端口，不能用于 amqp://
MANAGER_RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
MANAGER_MANAGER_ID=default
MANAGER_UPSTREAM_API_KEY=
MANAGER_ALLOW_LOCAL_PROVISION=true
