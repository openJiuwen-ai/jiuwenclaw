# 复制为 .env 后按需修改（Claw Manager 启动时自动加载）

# REST 服务
CLAW_MANAGER_REST_HOST=0.0.0.0
CLAW_MANAGER_REST_PORT=8765

# 数据库：sqlite | mysql
CLAW_MANAGER_DB_TYPE=sqlite
CLAW_MANAGER_SQLITE_PATH=claw_manager.db

# MySQL（CLAW_MANAGER_DB_TYPE=mysql 时生效）
CLAW_MANAGER_DB_HOST=127.0.0.1
CLAW_MANAGER_DB_PORT=3306
CLAW_MANAGER_DB_USER=root
CLAW_MANAGER_DB_PASSWORD=root
CLAW_MANAGER_DB_NAME=claw_manager

# 可选：RabbitMQ / 上游 / 本地 provision（保留 CLAWMANAGER_ 前缀）
# AMQP 默认端口 5672；15672 是 Management 管理界面 HTTP 端口，不能用于 amqp://
CLAWMANAGER_RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
CLAWMANAGER_MANAGER_ID=default
CLAWMANAGER_UPSTREAM_API_KEY=
CLAWMANAGER_ALLOW_LOCAL_PROVISION=false
