# 复制为 manager_ws_client/.env 后按需修改（Gateway manager_ws_client 扩展启动 DB 时读取）
#
# Provision 不会注入 MANAGER_WS_CLIENT_*；Gateway 扩展启动时读本文件（override=True）。
# SQLite 相对路径会拼到 JIUWENCLAW_DATA_DIR（实例目录）；也可用绝对路径。
# 可选：在实例 JIUWENCLAW_DATA_DIR/.env 中覆盖本文件。

# 数据库类型：sqlite | mysql
MANAGER_WS_CLIENT_DB_TYPE=sqlite

# SQLite 路径（相对路径：优先 JIUWENCLAW_DATA_DIR，否则相对本扩展目录）
MANAGER_WS_CLIENT_SQLITE_PATH=gateway.db

# MySQL（MANAGER_WS_CLIENT_DB_TYPE=mysql 时生效）
MANAGER_WS_CLIENT_DB_HOST=127.0.0.1
MANAGER_WS_CLIENT_DB_PORT=3306
MANAGER_WS_CLIENT_DB_USER=root
MANAGER_WS_CLIENT_DB_PASSWORD=root
MANAGER_WS_CLIENT_DB_NAME=gateway
