{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/component.schema.json",
  "title": "Component",
  "type": "object",
  "$defs": {
    "node": {
      "$dynamicAnchor": "node-anchor",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$dynamicRef": "#node-anchor" }
        }
      },
      "required": ["name", "type"]
    }
  },
  "properties": {
    "root": { "$dynamicRef": "#node-anchor" }
  },
  "required": ["root"]
}
