ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# 复用 registry 的 manager 镜像当 base,它结尾切到了非 root 的 app 用户;先切回 root
USER root

# base 可能已自带 app 用户,幂等处理
RUN id app >/dev/null 2>&1 || useradd --create-home --shell /bin/bash app

WORKDIR /app/jiuwenclaw
COPY . /app/jiuwenclaw/
RUN chown -R app:app /app/jiuwenclaw

# 用 root 执行 pip install → 安装到系统全局
RUN pip install -e "./packages/jiuwenclaw-ee/claw_manager" -i https://pypi.tuna.tsinghua.edu.cn/simple

USER app
WORKDIR /app/jiuwenclaw
ENV PATH=$PATH:/home/app/.local/bin

EXPOSE 8765 8766
CMD ["jiuwenclaw-manager"]
