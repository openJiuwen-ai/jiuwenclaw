ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Create app user and set up working directory
RUN useradd --create-home --shell /bin/bash app
RUN mkdir -p /app

# Copy project files
COPY --chown=app:app . /app/jiuwenclaw/

USER app

# Build web
WORKDIR /app/jiuwenclaw/jiuwenclaw/web
RUN npm install
RUN npm run build

# Install server dependencies
WORKDIR /app/jiuwenclaw
ENV PATH=$PATH:/home/app/.local/bin
# 容器内 web 后端绑 0.0.0.0（app_web/app_enterprise_web 的 --host 读此 env，取代旧的 sed 改源码）
ENV JIUWENCLAW_WEB_HOST=0.0.0.0
RUN pip install -i https://pypi.tuna.tsinghua.edu.cn/simple -e ".[all]" --no-cache-dir

# Start claw app
EXPOSE 5173
CMD ["jiuwenclaw-start"]
