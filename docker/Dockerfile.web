ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG VITE_PRODUCT_NAME=JiuwenSwarm
ENV VITE_PRODUCT_NAME=${VITE_PRODUCT_NAME}

# 创建 app 用户
RUN useradd --create-home --shell /bin/bash app
RUN mkdir -p /app

# 拷贝代码（所有权直接给 app）
COPY --chown=app:app . /app/jiuwenclaw/

# 先用 ROOT 全局安装 Python 包
WORKDIR /app/jiuwenclaw
RUN sed -i '/openjiuwen_runtime_foundation/d' pyproject.toml
RUN sed -i '/openjiuwen_runtime_foundation/d' packages/jiuwenclaw-ee/claw_manager/pyproject.toml
RUN sed -i '/openjiuwen_runtime_management/d' packages/jiuwenclaw-ee/gateway/extensions/runtime_management_extension/pyproject.toml
RUN pip install -i https://pypi.tuna.tsinghua.edu.cn/simple -e ".[all]" --no-cache-dir

# 切换成 app 用户，再执行 npm 构建
USER app
WORKDIR /app/jiuwenclaw/jiuwenclaw/web_enterprise
RUN npm install
RUN npm run build

# 配置环境变量
WORKDIR /app/jiuwenclaw
ENV PATH=$PATH:/home/app/.local/bin

# 暴露端口 + 启动
EXPOSE 5173
CMD ["jiuwenclaw-start", "web-enterprise"]