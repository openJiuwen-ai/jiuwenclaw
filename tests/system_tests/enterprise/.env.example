# Enterprise Gateway E2E static configuration.
# Copy to .env to override locally: cp .env.example .env
#
# Per-run values (HOME, ports, SQLITE path, repo paths, etc.) are injected in test code.

# Gateway
WEB_HOST=127.0.0.1
GATEWAY_HOST=127.0.0.1
GATEWAY_MANAGER_WS_CLIENT_ENABLED=false
LLM_SSL_VERIFY=false
IP=127.0.0.1
VIBESKILL_ENABLED=false

# Deploy mode
AGENT_SERVER_DEPLOY_MODE=process
DEPLOY_TYPE=subprocess
LOWCODE_IMAGE=local-process

# Runtime Orchestrator (RuntimeManagementAgentClient)
AGENT_SERVER_PORT=18092
AGENT_SERVER_PORT_NAME=http1
AGENT_SERVER_IMAGE=local-process
AGENT_SERVER_NAMESPACE=enterprise-e2e
AGENT_SERVER_CONTAINER_NAME=agentserver-e2e
AGENT_SERVER_IMAGE_PULL_POLICY=IfNotPresent
AGENT_RUNTIME=local
AGENT_SERVER_MIN_IDLE_SERVICES=1
AGENT_SERVER_MAX_SERVICES=10
AGENT_SERVER_SERVICE_CONCURRENCY=10
AGENT_SERVER_SERVICE_TTL=30
AGENT_SERVER_AUTOSCALE_INTERVAL=0.2
AGENT_SERVER_MESSAGE_TIMEOUT=300
AGENT_SERVER_SESSION_CONCURRENCY=10
AGENT_SERVER_SESSION_TTL=20
AGENT_SERVER_READINESS_INITIAL_DELAY=5
AGENT_SERVER_READINESS_PERIOD=10
AGENT_SERVER_READY_TIMEOUT=300
AGENT_SERVER_READY_POLL_INTERVAL=2

# Gateway database (GATEWAY_SQLITE_PATH is set per run in test code)
GATEWAY_DB_TYPE=sqlite
JIUWENCLAW_ID=enterprise_e2e_001

# Model (API_BASE is set per run with mock LLM port in test code)
MODEL_PROVIDER=OpenAI
MODEL_NAME=mock-model
API_KEY=mock-key

PIP_EXTRA_ARGS="-i https://mirrors.aliyun.com/pypi/simple"